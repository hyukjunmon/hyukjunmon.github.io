---
interface Props {
  value: string;
  label: string;
  unit?: string;
}

const { value, label, unit } = Astro.props;
---

<div class="stat">
  <p class="stat__value">
    {value}
    {unit && <span class="stat__unit">{unit}</span>}
  </p>
  <p class="stat__label">{label}</p>
</div>

<style>
  .stat__value {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }

  .stat__unit {
    margin-left: 2px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
  }

  .stat__label {
    margin: 6px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }
</style>
