---
interface RetroItem {
  type: 'learn' | 'lesson';
  content: string;
}

interface Props {
  items: RetroItem[];
}

const { items } = Astro.props;
const learn = items.filter((item) => item.type === 'learn');
const lesson = items.filter((item) => item.type === 'lesson');

const groups = [
  { label: '배운 점', items: learn },
  { label: '교훈', items: lesson },
];
---

<div class="retro">
  {
    groups.map((group) => (
      <section class="retro__card">
        <h5>{group.label}</h5>
        <ul>
          {group.items.map((item) => (
            <li>{item.content}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .retro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-block: 32px;
  }

  .retro__card {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }

  h5 {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    margin-top: 8px;
    padding-left: 18px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--body-c);
  }

  li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--subtle);
  }

  @media (max-width: 640px) {
    .retro {
      grid-template-columns: 1fr;
    }
  }
</style>
