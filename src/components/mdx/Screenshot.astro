---
interface Annotation {
  x: number;
  y: number;
  label: string;
}

interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  annotations?: Annotation[];
}

const { src, alt, caption, width = 800, height = 500, annotations } = Astro.props;
const markers = annotations ?? [];
---

<figure class="shot">
  <div class="shot__media">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" />
    {
      markers.length > 0 && (
        <svg class="shot__overlay" aria-hidden="true">
          {markers.map((marker, i) => (
            <g>
              <circle
                cx={`${marker.x}%`}
                cy={`${marker.y}%`}
                r="13"
                fill="rgba(255, 255, 255, 0.92)"
                stroke="var(--accent)"
                stroke-width="2"
              />
              <text
                x={`${marker.x}%`}
                y={`${marker.y}%`}
                dy="4"
                text-anchor="middle"
                class="shot__overlay-num"
              >
                {i + 1}
              </text>
              <text
                x={`${marker.x}%`}
                y={`${marker.y}%`}
                dx="20"
                dy="4"
                class="shot__overlay-label"
              >
                {marker.label}
              </text>
            </g>
          ))}
        </svg>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin-block: 32px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }

  .shot__media {
    position: relative;
  }

  .shot__media img {
    width: 100%;
    height: auto;
  }

  .shot__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .shot__overlay-num {
    font-size: 11px;
    font-weight: 700;
    fill: var(--accent-deep);
  }

  .shot__overlay-label {
    font-size: 12px;
    font-weight: 600;
    fill: var(--ink);
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 4px;
  }

  figcaption {
    padding: 12px 16px;
    border-top: 1px solid var(--hairline);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
