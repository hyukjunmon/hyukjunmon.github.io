---
import SectionHeading from './SectionHeading.astro';
import { career } from '../data/career';

const TYPE_LABELS: Record<string, string> = {
  job: '직장',
  internship: '인턴',
  project: '프로젝트',
  experience: '대외 활동',
  education: '교육',
  degree: '학위',
};

interface Item {
  type: string;
  title: string;
  subtitle: string;
  date: string;
  displayDate?: string;
  ongoing: boolean;
  link?: string;
  year: string;
  month?: string;
  description: string;
}

const items: Item[] = career.map((item) => {
  const [year, month] = item.date.split('.');
  return {
    ...item,
    year,
    month,
    ongoing: item.ongoing ?? false,
  };
});

items.sort((a, b) => {
  if (a.year !== b.year) return b.year.localeCompare(a.year);
  if (a.ongoing !== b.ongoing) return a.ongoing ? -1 : 1;
  return (b.month ?? '').localeCompare(a.month ?? '');
});

interface YearGroup {
  year: string;
  items: Item[];
}

const groups = items.reduce<YearGroup[]>((acc, item) => {
  const last = acc[acc.length - 1];
  if (last && last.year === item.year) {
    last.items.push(item);
  } else {
    acc.push({ year: item.year, items: [item] });
  }
  return acc;
}, []);
---

<div class="section" id="career">
  <div class="container">
    <SectionHeading title="Career" />
    <div class="timeline fade-up">
      {
        groups.map((group) => (
          <div class="tl-group">
            <span class="tl-year">{group.year}</span>
            <div class="tl-items">
              {group.items.map((item) => (
                <div class="tl-item">
                  <span class="tl-dot" aria-hidden="true" />
                  <p class="tl-meta">
                    <span class="tl-type">{TYPE_LABELS[item.type]}</span>
                    <span class="tl-date">{item.displayDate || (item.month ? `${item.month}월` : `${item.year}`)}</span>
                  </p>
                  <h3 class="tl-title">
                    {item.link ? (
                      <a href={item.link} target="_blank" rel="noopener noreferrer">
                        {item.title}
                      </a>
                    ) : (
                      item.title
                    )}
                    <span>{item.subtitle}</span>
                  </h3>
                  <div class="tl-body"><p>{item.description}</p></div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .timeline {
    --rail-x: 52px;
  }

  .tl-group {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
  }

  .tl-group + .tl-group {
    margin-top: 40px;
  }

  .tl-year {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 550;
    color: var(--ink);
    grid-row: 1;
    white-space: nowrap;
    margin-top: -20px;
  }

  .tl-items {
    position: relative;
    grid-row: 1 / span all;
    grid-column: 2;
  }

  .tl-items::before {
    content: '';
    position: absolute;
    top: 7px;
    bottom: 0;
    left: var(--rail-x);
    width: 1px;
    background: var(--hairline);
  }

  .tl-item {
    position: relative;
    padding-left: 64px;
  }

  .tl-item + .tl-item {
    margin-top: 24px;
  }

  .tl-dot {
    position: absolute;
    top: 7px;
    left: calc(var(--rail-x) + 0.5px);
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tl-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    color: var(--subtle);
  }

  .tl-type {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--chip);
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .tl-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-size: clamp(15px, 2.3vw, 17px);
    font-weight: 700;
  }

  .tl-title span {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }

  .tl-title a {
    color: inherit;
    text-decoration: none;
  }

  .tl-title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tl-body :global(p) {
    margin-top: 6px;
    max-width: 560px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .tl-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .timeline {
      --rail-x: 32px;
    }

    .tl-item {
      padding-left: 46px;
    }
  }
</style>
