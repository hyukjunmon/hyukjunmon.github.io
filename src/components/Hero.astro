---
import { profile } from '../data/profile';
---

<section class="hero" id="top">
  <div class="container">
    <h1 class="hero__title" style="--delay: 80ms">
      안녕하세요.<br />
      <em>{profile.role}</em>, {profile.name}입니다.
    </h1>
    <p class="hero__tagline" style="--delay: 160ms">{profile.tagline}</p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: var(--nav-h);
    background: radial-gradient(
      ellipse 720px 560px at 24% 42%,
      rgba(3, 105, 161, 0.1),
      transparent 70%
    );
  }

  .hero__title {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }

  .hero__tagline {
    max-width: 560px;
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
    white-space: pre-wrap;
  }

  @media (max-width: 640px) {
    .hero {
      background: radial-gradient(
        ellipse 420px 380px at 30% 38%,
        rgba(3, 105, 161, 0.1),
        transparent 70%
      );
    }
  }
</style>
