---
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/profile';
import avatarImage from '../assets/profile/avatar.jpeg';

const github = profile.socials.find((s) => s.label === 'GitHub');
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
const [emailUser, emailDomain] = profile.email.split('@');
---

<div class="section section--alt" id="about">
  <div class="container">
    <SectionHeading title="About ME" />
    <div class="about fade-up">
      <div class="about__media">
        <img src={avatarImage.src} alt={`${profile.name} 프로필 사진`} width={avatarImage.width} height={avatarImage.height} />
      </div>
      <div class="about__main">
        <p class="about__name">
          {profile.name}
          <span>{profile.englishName}</span>
        </p>
        <div class="about__intro">
          {profile.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ul class="about__skills" aria-label="핵심 기술">
          {profile.coreSkills.map((skill) => <li class="chip">{skill}</li>)}
        </ul>
        <nav class="about__links" aria-label="소셜 링크">
        {
          github && (
            <a href={github.url} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
            </a>
          )
        }
        <a
          id="email-link"
          data-user={emailUser}
          data-domain={emailDomain}
          aria-label="이메일"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="M22 7l-10 6L2 7" />
          </svg>
        </a>
        {
          linkedin && (
            <a href={linkedin.url} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
              </svg>
            </a>
          )
        }
      </nav>
      </div>
    </div>
  </div>
</div>

<div class="copy-toast" id="copy-toast" role="status" aria-live="polite"></div>

<script>
  function initEmailCopy() {
    const emailLink = document.getElementById('email-link') as HTMLAnchorElement | null;
    const toast = document.getElementById('copy-toast');
    if (!emailLink) return;

    const address = `${emailLink.dataset.user}@${emailLink.dataset.domain}`;
    emailLink.href = `mailto:${address}`;
    emailLink.title = address;

    let timer: number | undefined;
    const showToast = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-show');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove('is-show'), 2000);
    };

    emailLink.addEventListener('click', (event) => {
      if (!navigator.clipboard) return;
      event.preventDefault();
      navigator.clipboard
        .writeText(address)
        .then(() => showToast(`${address} 복사됨`))
        .catch(() => {
          window.location.href = `mailto:${address}`;
        });
    });
  }

  document.addEventListener('astro:page-load', initEmailCopy);
</script>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 56px;
    align-items: center;
  }

  .about__main {
    grid-column: 1;
    grid-row: 1;
  }

  .about__media {
    grid-column: 2;
    grid-row: 1;
  }

  .about__media img,
  .about__media-slot {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }

  .about__media-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    color: var(--subtle);
  }

  .about__media-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    color: var(--subtle);
  }

  .about__name {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 24px;
    font-weight: 700;
  }

  .about__name span {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--subtle);
  }

  .about__intro {
    max-width: 640px;
    margin-top: 20px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--body-c);
    white-space: pre-wrap;
  }

  .about__intro p + p {
    margin-top: 14px;
  }

  .about__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .about__links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
  }

  .about__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    color: var(--muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .about__links a:hover {
    color: var(--accent);
    background: var(--accent-tint);
  }

  .copy-toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translate(-50%, 8px);
    opacity: 0;
    pointer-events: none;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: #fff;
    font-size: 13.5px;
    font-weight: 500;
    z-index: 70;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .copy-toast.is-show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 834px) {
    .about {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .about__main {
      grid-column: 1;
      grid-row: 2;
    }

    .about__media {
      grid-column: 1;
      grid-row: 1;
      width: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-toast {
      transition: none;
    }
  }
</style>
