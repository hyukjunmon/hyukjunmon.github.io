---
import { profile } from '../data/profile';
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#career', label: 'Career' },
];
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo">{profile.name}<span>.</span></a>
    <nav class="nav__links" aria-label="주요 섹션">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a
      class="nav__cta"
      href={profile.socials[0]?.url ?? '#'}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub ↗
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--nav-h);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav.is-scrolled {
    background: rgba(254, 249, 243, 0.86);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    backdrop-filter: blur(12px) saturate(160%);
    box-shadow: 0 1px 0 var(--hairline);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }

  .nav__logo {
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
  }

  .nav__logo span {
    color: var(--accent);
  }

  .nav__links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .nav__links a {
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: var(--radius-pill);
    padding: 7px 16px;
    font-size: 13.5px;
    font-weight: 600;
    min-height: 36px;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .nav__cta:hover {
    background: var(--accent-tint);
  }

  .nav__cta:active {
    transform: scale(0.97);
  }

  @media (max-width: 834px) {
    .nav__links {
      display: none;
    }
  }
</style>
