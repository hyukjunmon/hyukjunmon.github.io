---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import GlobalNav from '../components/GlobalNav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <meta name="theme-color" content="#fef9f3" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <GlobalNav />
    <main>
      <slot />
    </main>
    <Footer />

    <style>
      .progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--accent);
        transform-origin: left;
        transform: scaleX(0);
        z-index: 60;
      }
    </style>

    <script>
      function initPage() {
        const progress = document.getElementById('progress');
        const nav = document.getElementById('site-nav');

        const onScroll = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const ratio = max > 0 ? doc.scrollTop / max : 0;
          if (progress) progress.style.transform = `scaleX(${ratio})`;
          if (nav) nav.classList.toggle('is-scrolled', doc.scrollTop > 8);
        };

        document.removeEventListener('scroll', onScroll);
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        const revealEls = Array.from(
          document.querySelectorAll<HTMLElement>('.fade-up:not(.is-visible)')
        );

        for (const el of revealEls) {
          const top = el.getBoundingClientRect().top;
          if (top < 0 || top >= window.innerHeight) {
            el.style.setProperty('--delay', '0ms');
          }
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        revealEls.forEach((el) => observer.observe(el));
      }

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
