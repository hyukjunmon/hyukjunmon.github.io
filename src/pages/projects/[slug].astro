---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: any;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const allProjects = await getCollection('projects');
const idx = allProjects.findIndex((p) => p.id === project.id);
const next = allProjects[(idx + 1) % allProjects.length];
const data = project.data;

const h2Headings = headings.filter((h: any) => h.depth === 2);
---

<BaseLayout title={`${data.title} — 케이스 스터디`} description={data.tagline}>
  <article class="case">
    <header class="container head">
      <a class="back fade-up" href="/#projects">← 모든 프로젝트</a>

      <p class="meta fade-up" style="--delay: 60ms">
        <span>{data.year}</span>
        {data.domain.map((tag: string) => (
          <>
            <span aria-hidden="true">·</span>
            <span>{tag}</span>
          </>
        ))}
      </p>

      <h1 class="fade-up" style="--delay: 120ms">{data.title}</h1>
      <p class="tagline fade-up" style="--delay: 180ms">{data.tagline}</p>

      <div class="actions fade-up" style="--delay: 240ms">
        {
          data.links?.live && (
            <a class="btn btn--primary" href={data.links.live} target="_blank" rel="noopener noreferrer">
              사이트 방문 ↗
            </a>
          )
        }
        {
          data.links?.repos && data.links.repos.map((repo: any) => (
            <a class="btn btn--ghost" href={repo.url} target="_blank" rel="noopener noreferrer">
              {repo.label} ↗
            </a>
          ))
        }
      </div>

      <figure class="shot fade-up" style="--delay: 300ms">
        <img src={data.image} alt={`${data.title} 스크린샷`} width="800" height="500" />
      </figure>
    </header>

    <div class="case__wrapper">
      <nav class="toc">
        <p class="toc__label">On this page</p>
        <ul class="toc__list">
          {h2Headings.map((heading: any) => (
            <li>
              <a href={`#${heading.slug}`} data-section={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="container-text body">
        <Content />
      </div>
    </div>

    <a class="next" href={`/projects/${next.id}/`}>
      <div class="next__inner container">
        <span class="next__label">Next Project</span>
        <span class="next__title">{next.data.title} →</span>
        <span class="next__tagline">{next.data.tagline}</span>
      </div>
    </a>
  </article>
</BaseLayout>

<script>
  const links = document.querySelectorAll('.toc__list a');
  const sections = document.querySelectorAll('h2');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        links.forEach(link => {
          link.classList.toggle('active', link.getAttribute('data-section') === id);
        });
      }
    });
  }, { rootMargin: '0px 0px -80% 0px' });

  sections.forEach(section => observer.observe(section));
</script>

<style>
  .case {
    padding-top: calc(var(--nav-h) + 64px);
  }

  .back {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    font-size: 14px;
    color: var(--subtle);
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .tagline {
    max-width: 640px;
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .shot {
    margin: 48px 0 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .case__wrapper {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    padding-top: 24px;
  }

  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    height: fit-content;
    font-size: 14px;
  }

  .toc__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc__list a {
    display: block;
    padding: 8px 0;
    color: var(--subtle);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 12px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc__list a:hover {
    color: var(--muted);
  }

  .toc__list a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .body {
    padding-block: 24px 96px;
  }

  .body :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 700;
    margin: 56px 0 16px;
  }

  .body :global(h2::before) {
    content: '§';
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--accent);
  }

  .body :global(p) {
    margin-bottom: 14px;
    line-height: 1.75;
  }

  .next {
    display: block;
    background: var(--surface);
    border-top: 1px solid var(--hairline);
    padding-block: 48px;
    transition: background-color 0.25s ease;
  }

  .next:hover {
    background: var(--bg);
  }

  .next__inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .next__label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .next__title {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: var(--ink);
  }

  .next__tagline {
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .case__wrapper {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      margin-bottom: 32px;
    }
  }
</style>

